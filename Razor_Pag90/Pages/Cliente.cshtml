@page
@model Razor_Pag90.Pages.ClienteModel
@{
    ViewData["Title"] = "Listado de Clientes";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Listado de Clientes</h1>

<p>
    <a asp-page="/CrearCliente" class="btn btn-primary">Crear Nuevo Cliente</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre del Cliente</th>
            <th>Email del Cliente</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ListaClientes != null && Model.ListaClientes.Any())
        {
            @foreach (var cliente in Model.ListaClientes)
            {
                <tr>
                    <td>@cliente.Id</td>
                    <td>@cliente.Nombre</td>
                    <td>@cliente.Email</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">No hay clientes registrados aún.</td>
            </tr>
        }
    </tbody>
</table>