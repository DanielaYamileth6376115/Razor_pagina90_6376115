@page
@model Razor_Pag90.Pages.ClienteModel
@{
    ViewData["Title"] = "Listado de Clientes";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Listado de Clientes</h1>
    <a asp-page="/CrearClientes" class="btn btn-primary">
        <i class="fas fa-plus"></i> Nuevo Cliente
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre del Cliente</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListaClientes != null && Model.ListaClientes.Any())
                    {
                        @foreach (var cliente in Model.ListaClientes)
                        {
                            <tr>
                                <td>@cliente.Id</td>
                                <td>@cliente.Nombre</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center">No hay clientes registrados aún.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>