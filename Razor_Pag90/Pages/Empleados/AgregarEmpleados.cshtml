@page
@model Razor_Pag90.Pages.Empleados.AgregarEmpleadosModel
@{
}

<h1>Ingresar nuevos empleados</h1>
<form class="form-group" method="post">
    
    <input class="form-control" type="text" asp-for="Empleado.Nombre" placeholder="Nombre">
    
        <input class="form-control" type="number" placeholder="Edad">
    
