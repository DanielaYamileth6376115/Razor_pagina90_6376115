@page
@model Razor_Pag90.Pages.OficinaModel
@{
    ViewData["Title"] = "Listado de Oficinas";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Listado de Oficinas</h1>

<p>
    <a asp-page="/CrearOficionas" class="btn btn-primary">Crear Nueva Oficina</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre de la Oficina</th>
            <th>Dirección</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ListaOficinas != null && Model.ListaOficinas.Any())
        {
            @foreach (var oficina in Model.ListaOficinas)
            {
                <tr>
                    <td>@oficina.Id</td>
                    <td>@oficina.Nombre</td>
                    <td>@oficina.Direccion</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">No hay oficinas registradas aún.</td>
            </tr>
        }
    </tbody>
</table>